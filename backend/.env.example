# Environment (dev | prod)
ENVIRONMENT=dev

# LLM API Configuration
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-5.3-codex

# Supabase (optional, uses in-memory store if not set)
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=interview-copilot

# CORS (comma-separated, defaults to http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Database (not used in MVP, Supabase preferred)
DATABASE_URL=postgresql://user:password@localhost:5432/interview_copilot
